# ─── SEC EDGAR ───────────────────────────────────────────────
# SEC requires a descriptive User-Agent on every request.
# Use a real contact email so SEC can reach you if needed.
SEC_USER_AGENT="AI Equity Research Terminal your-email@example.com"

# ─── Supabase (reserved for the AI / persistence phase) ──────
# Reuse your existing Supabase project. All tables for this app
# will live in a dedicated "equity" schema to avoid collisions.
# DATABASE_URL="postgresql://...supabase.../postgres?schema=equity"

# ─── OpenAI (reserved for the AI phase) ──────────────────────
# OPENAI_API_KEY="sk-..."
