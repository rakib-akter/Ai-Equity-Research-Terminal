# ─── SEC EDGAR ───────────────────────────────────────────────
# SEC requires a descriptive User-Agent on every request.
# Use a real contact email so SEC can reach you if needed.
SEC_USER_AGENT="AI Equity Research Terminal your-email@example.com"

# ─── AI provider (Phase 2) ───────────────────────────────────
# Default = Google Gemini free tier. Get a free key at
# https://aistudio.google.com/apikey
AI_API_KEY=""
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
AI_CHAT_MODEL="gemini-2.5-flash"
AI_EMBEDDING_MODEL="gemini-embedding-001"
AI_EMBEDDING_DIM="768"
# To use OpenAI instead: AI_BASE_URL=https://api.openai.com/v1,
#   AI_CHAT_MODEL=gpt-4o-mini, AI_EMBEDDING_MODEL=text-embedding-3-small,
#   AI_EMBEDDING_DIM=1536 (then re-run migrations + re-embed).

# ─── Supabase / Postgres (Phase 2) ───────────────────────────
# Reuse your EXISTING Supabase project. Tables live in a dedicated
# "equity" schema to avoid collisions with your other project.
# From Supabase: Settings -> Database -> Connection string.
#   DATABASE_URL = pooled (port 6543) — used by the app at runtime
#   DIRECT_URL   = direct (port 5432) — used by Prisma migrations
# Append ?schema=equity to keep this app isolated.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?schema=equity&pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=equity"
